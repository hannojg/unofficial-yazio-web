{
  "manifest_version": 3,
  "name": "Nutrition Desk",
  "version": "2.1.1",
  "minimum_chrome_version": "120",
  "description": "Your YAZIO food diary, recent foods, and water tracking in a full-size browser tab.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://yzapi.yazio.com/*",
    "https://www.yazio.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Nutrition Desk",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.yazio.com/*"
      ],
      "js": [
        "read-session.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.yazio.com/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src https://yzapi.yazio.com https://www.yazio.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'"
  }
}
